# This is a portfolio/demo build — seeded with fake data via seed_data.py.
# Leave the API/sheet integration vars below empty and AUTO_SYNC=false so it
# never tries to reach any real external data source.
DATABASE_URL=sqlite:///./bookinguru.db
DASHBOARD_USER=bookinguru
DASHBOARD_PASS=investor2026
# The frontend login screen is a UX gate, not a backend-enforced auth layer —
# set this to true so the API accepts requests without needing real Basic
# Auth headers wired up (matches how the live demo deployment runs).
AUTH_DISABLED=true

# Live bookings API (optional — leave empty for the demo)
BOOKINGURU_REPORTS_API_KEY=
# Google Sheet for Rooms/Aliases/Forecast tabs (optional — leave empty for the demo)
GOOGLE_SHEET_ID=
# Auto-sync cadence while the server is running (seconds; default 300 = 5 min)
AUTO_SYNC_INTERVAL_SECONDS=300
# Set to false to disable the automatic background sync (recommended for the demo)
AUTO_SYNC=false
# Alsabini margin rate applied to ALSABINI-provider bookings (see api_sync.py)
ALSABINI_TAKE_RATE=0.05
